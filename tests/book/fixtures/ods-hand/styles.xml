<?xml version="1.0" encoding="UTF-8"?>
<!-- Written by hand from OASIS ODF 1.2 for libowf's tests. -->
<office:document-styles xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:n="urn:oasis:names:tc:opendocument:xmlns:datastyle:1.0" office:version="1.2">
 <office:font-face-decls>
  <style:font-face style:name="Sans" svg:font-family="'DejaVu Sans'" style:font-family-generic="swiss"/>
  <style:font-face style:name="Mono" svg:font-family="&apos;DejaVu Sans Mono&apos;" style:font-family-generic="modern"/>
 </office:font-face-decls>
 <office:styles>
  <n:number-style style:name="Money"><n:number n:decimal-places="2" n:min-integer-digits="1" n:grouping="true"/></n:number-style>
  <style:default-style style:family="table-cell"><style:text-properties style:font-name="Sans" fo:font-size="11pt"/></style:default-style>
  <style:default-style style:family="table-column"><style:table-column-properties style:column-width="1in"/></style:default-style>
  <style:style style:name="Default" style:family="table-cell"><style:text-properties fo:color="#333333"/></style:style>
  <style:style style:name="Heading" style:family="table-cell" style:parent-style-name="Default" style:data-style-name="Money">
   <style:table-cell-properties fo:background-color="#ddeeff" fo:border-bottom="1.76pt dashed #123456" style:vertical-align="top"/>
   <style:text-properties fo:font-weight="700" fo:font-size="14pt"/>
  </style:style>
 </office:styles>
</office:document-styles>

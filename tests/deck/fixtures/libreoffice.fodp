   <draw:frame presentation:style-name="Default-outline1" draw:layer="backgroundobjects" svg:width="25.2cm" svg:height="9.135cm" svg:x="1.4cm" svg:y="3.7cm" presentation:class="outline" presentation:placeholder="true">
    <draw:text-box/>
   </draw:frame>
   <draw:frame presentation:style-name="pr1" draw:layer="backgroundobjects" svg:width="6.5cm" svg:height="0.9cm" svg:x="1.4cm" svg:y="14.2cm" presentation:class="date-time">
    <draw:text-box>
     <text:p><presentation:date-time/></text:p>
    </draw:text-box>
   </draw:frame>
   <draw:frame presentation:style-name="pr1" draw:layer="backgroundobjects" svg:width="8.8cm" svg:height="0.9cm" svg:x="9.6cm" svg:y="14.2cm" presentation:class="footer">
    <draw:text-box>
     <text:p text:style-name="P8"><presentation:footer/></text:p>
    </draw:text-box>
   </draw:frame>
   <draw:frame presentation:style-name="pr1" draw:layer="backgroundobjects" svg:width="6.5cm" svg:height="0.9cm" svg:x="20.1cm" svg:y="14.2cm" presentation:class="page-number">
    <draw:text-box>
     <text:p text:style-name="P9"><text:page-number>&lt;number&gt;</text:page-number></text:p>
    </draw:text-box>
   </draw:frame>
   <presentation:notes style:page-layout-name="PM0">
    <draw:page-thumbnail presentation:style-name="Default-title" draw:layer="backgroundobjects" svg:width="13.6cm" svg:height="7.65cm" svg:x="3.7cm" svg:y="2cm" presentation:class="page"/>
    <draw:frame presentation:style-name="Default-notes" draw:layer="backgroundobjects" svg:width="17cm" svg:height="17cm" svg:x="2cm" svg:y="10.6cm" presentation:class="notes" presentation:placeholder="true">
     <draw:text-box/>
    </draw:frame>
   </presentation:notes>
  </style:master-page>
 </office:master-styles>
 <office:body>
  <office:presentation><presentation:footer-decl presentation:name="ftr1">Team 5 &amp; friends</presentation:footer-decl><presentation:date-time-decl presentation:name="dtd1" presentation:source="fixed">25 October 2026</presentation:date-time-decl>
   <draw:page draw:name="page1" draw:style-name="dp3" draw:master-page-name="Default" presentation:presentation-page-layout-name="AL1T0" presentation:use-footer-name="ftr1" presentation:use-date-time-name="dtd1" xml:id="id1" draw:id="id1">
    <draw:frame presentation:style-name="pr2" draw:text-style-name="P6" draw:layer="layout" svg:width="24cm" svg:height="4cm" svg:x="2cm" svg:y="3cm" presentation:class="title">
     <draw:text-box>
      <text:p>OpenPresentation</text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame presentation:style-name="pr3" draw:text-style-name="P6" draw:layer="layout" svg:width="24cm" svg:height="4cm" svg:x="2cm" svg:y="8cm" presentation:class="subtitle">
     <draw:text-box>
      <text:p>Phase P1 — the model &amp; ODP</text:p>
     </draw:text-box>
    </draw:frame>
    <anim:par presentation:node-type="timing-root">
     <anim:par smil:begin="id1.begin">
      <anim:transitionFilter smil:dur="3s" smil:type="fade" smil:subtype="crossfade"/>
     </anim:par>
    </anim:par>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr6" draw:layer="layout" svg:width="13.6cm" svg:height="7.65cm" svg:x="3.7cm" svg:y="2cm" draw:page-number="1" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:layer="layout" svg:width="17cm" svg:height="17cm" svg:x="2cm" svg:y="10.6cm" presentation:class="notes">
      <draw:text-box>
       <text:p>Welcome everyone.</text:p>
       <text:p>Say what P1 is.</text:p>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="page2" draw:style-name="dp4" draw:master-page-name="Default" presentation:presentation-page-layout-name="AL2T1" presentation:use-footer-name="ftr1" xml:id="id2" draw:id="id2">
    <draw:frame presentation:style-name="pr5" draw:text-style-name="P6" draw:layer="layout" svg:width="25.2cm" svg:height="2.6cm" svg:x="1.4cm" svg:y="0.6cm" presentation:class="title">
     <draw:text-box>
      <text:p>Bullets and numbers</text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame presentation:style-name="pr6" draw:text-style-name="P6" draw:layer="layout" svg:width="14cm" svg:height="9.1cm" svg:x="1.4cm" svg:y="3.7cm" presentation:class="outline">
     <draw:text-box>
      <text:list text:style-name="L2">
       <text:list-item>
        <text:p>A point with <text:span text:style-name="T1">bold red</text:span> words</text:p>
       </text:list-item>
      </text:list>
      <text:list text:style-name="L3">
       <text:list-item>
        <text:list>
         <text:list-item>
          <text:p>A second level, <text:span text:style-name="T2">italic</text:span></text:p>
         </text:list-item>
        </text:list>
       </text:list-item>
      </text:list>
      <text:list text:style-name="L4">
       <text:list-item>
        <text:list>
         <text:list-item>
          <text:list>
           <text:list-item>
            <text:p>A third level</text:p>
           </text:list-item>
          </text:list>
         </text:list-item>
        </text:list>
       </text:list-item>
       <text:list-item>
        <text:p>See <text:a xlink:href="https://github.com/DalsinAI" xlink:type="simple">DalsinAI</text:a><text:s/>for more</text:p>
       </text:list-item>
      </text:list>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:name="Steps" draw:style-name="gr7" draw:text-style-name="P10" draw:layer="layout" svg:width="10cm" svg:height="6cm" svg:x="16.5cm" svg:y="4cm">
     <draw:text-box>
      <text:list text:style-name="L5">
       <text:list-item>
        <text:p>Open</text:p>
       </text:list-item>
       <text:list-item>
        <text:p>Save</text:p>
        <text:list>
         <text:list-item>
          <text:p>as ODP</text:p>
         </text:list-item>
         <text:list-item>
          <text:p>as PDF</text:p>
         </text:list-item>
        </text:list>
       </text:list-item>
       <text:list-item>
        <text:p>Show</text:p>
       </text:list-item>
      </text:list>
      <text:p text:style-name="P9">Right<text:tab/>tab <text:s text:c="2"/>spaces<text:line-break/>new line</text:p>
     </draw:text-box>
    </draw:frame>
    <anim:par presentation:node-type="timing-root">
     <anim:par smil:begin="id2.begin">
      <anim:transitionFilter smil:dur="1s" smil:type="pushWipe" smil:subtype="fromRight"/>
     </anim:par>
    </anim:par>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr6" draw:layer="layout" svg:width="13.6cm" svg:height="7.65cm" svg:x="3.7cm" svg:y="2cm" draw:page-number="2" presentation:class="page"/>
     <draw:frame presentation:style-name="pr4" draw:layer="layout" svg:width="17cm" svg:height="17cm" svg:x="2cm" svg:y="10.6cm" presentation:class="notes">
      <draw:text-box>
       <text:p>Lists keep their levels.</text:p>
      </draw:text-box>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="page3" draw:style-name="dp5" draw:master-page-name="Default" xml:id="id3" draw:id="id3">
    <draw:frame presentation:style-name="pr5" draw:text-style-name="P6" draw:layer="layout" svg:width="25.2cm" svg:height="2.6cm" svg:x="1.4cm" svg:y="0.6cm" presentation:class="title">
